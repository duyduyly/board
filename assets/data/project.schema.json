{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Card Atlas Project 1.0",
  "type": "object",
  "required": [
    "version",
    "cards",
    "relations"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "canvas": {
      "$ref": "#/$defs/canvas"
    },
    "cards": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*:.+$"
      },
      "properties": {
        "card-atlas:views": {
          "type": "object",
          "properties": {
            "mindMap": {
              "$ref": "#/$defs/mindView"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "card-atlas:mind-map": {
          "type": "object",
          "properties": {
            "rootId": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*:.+$"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zoom": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 4
        },
        "position": {
          "$ref": "#/$defs/point"
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "summary": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "content": {
          "type": "string",
          "maxLength": 100000
        },
        "position": {
          "$ref": "#/$defs/point"
        },
        "size": {
          "$ref": "#/$defs/size"
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backgroundColor": {
              "$ref": "#/$defs/color"
            },
            "textColor": {
              "$ref": "#/$defs/color"
            },
            "borderColor": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*:.+$"
          },
          "properties": {
            "card-atlas:typography": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "object",
                  "properties": {
                    "fontSize": {
                      "type": "number",
                      "minimum": 8,
                      "maximum": 72
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "fontFamily": {
                      "enum": [
                        "system",
                        "serif",
                        "mono"
                      ]
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "summary": {
                  "type": "object",
                  "properties": {
                    "fontSize": {
                      "type": "number",
                      "minimum": 8,
                      "maximum": 72
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "fontFamily": {
                      "enum": [
                        "system",
                        "serif",
                        "mono"
                      ]
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "type": {
                  "type": "object",
                  "properties": {
                    "fontSize": {
                      "type": "number",
                      "minimum": 8,
                      "maximum": 72
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "fontFamily": {
                      "enum": [
                        "system",
                        "serif",
                        "mono"
                      ]
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "card-atlas:metadata": {
              "type": "object",
              "properties": {
                "createdDate": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "pinned": {
                  "type": "boolean"
                },
                "createdAt": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "card-atlas:node": {
              "$ref": "#/$defs/nodePresentation"
            },
            "card-atlas:appearance": {
              "type": "object",
              "properties": {
                "radius": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "borderWidth": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 8
                },
                "titleFontSize": {
                  "type": "number",
                  "minimum": 12,
                  "maximum": 72
                },
                "align": {
                  "enum": [
                    "left",
                    "center",
                    "right"
                  ]
                },
                "shadow": {
                  "enum": [
                    "none",
                    "soft"
                  ]
                },
                "backgroundTransparent": {
                  "type": "boolean"
                },
                "borderTransparent": {
                  "type": "boolean"
                },
                "shape": {
                  "enum": [
                    "rectangle",
                    "rounded",
                    "square",
                    "circle",
                    "ellipse",
                    "diamond",
                    "triangle",
                    "hexagon",
                    "star",
                    "heart",
                    "octagon",
                    "arrow",
                    "isosceles-triangle",
                    "right-triangle"
                  ]
                },
                "sizeMode": {
                  "enum": [
                    "manual",
                    "fit"
                  ]
                }
              },
              "required": [],
              "additionalProperties": false
            }
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "$ref": "#/$defs/color"
            },
            "line": {
              "enum": [
                "solid",
                "dashed",
                "dotted"
              ]
            },
            "arrow": {
              "enum": [
                "none",
                "start",
                "end",
                "both"
              ]
            }
          }
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*:.+$"
          },
          "properties": {
            "card-atlas:mind-map": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "branch",
                    "reference"
                  ]
                },
                "color": {
                  "$ref": "#/$defs/color"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          }
        }
      }
    },
    "nodePresentation": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "card",
            "text",
            "image",
            "image-text"
          ]
        },
        "coverImageId": {
          "type": "string",
          "minLength": 1
        },
        "imageFit": {
          "enum": [
            "contain",
            "cover"
          ]
        },
        "imageAlt": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "image",
                  "image-text"
                ]
              }
            }
          },
          "then": {
            "required": [
              "coverImageId"
            ]
          }
        }
      ]
    },
    "mindView": {
      "type": "object",
      "properties": {
        "positions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/point"
          }
        },
        "sizes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/size"
          }
        },
        "viewport": {
          "type": "object",
          "properties": {
            "zoom": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 4
            },
            "position": {
              "$ref": "#/$defs/point"
            }
          },
          "required": [
            "zoom",
            "position"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
