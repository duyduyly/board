{
  "name": "card-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*-core.test.mjs tests/core.test.mjs",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.modules.json",
    "e2e": "playwright test",
    "format": "prettier --write index.html assets/css assets/js scripts tests playwright.config.js eslint.config.js",
    "format:check": "prettier --check index.html assets/css assets/js scripts tests playwright.config.js eslint.config.js",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "ajv": "8.20.0",
    "bootstrap": "5.3.8",
    "codemirror": "6.0.2",
    "cytoscape": "3.34.3",
    "dompurify": "3.4.17",
    "grapesjs": "0.23.9",
    "highlight.js": "11.12.0",
    "marked": "18.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
